# Copy to ~/.config/traffic-collector/collector.env, then chmod 600 it.
# This is sourced by scripts/run_collector.sh; quote values containing spaces.
GOOGLE_MAPS_API_KEY='replace-me'
SUPABASE_URL='https://your-project.supabase.co'
SUPABASE_SERVICE_ROLE_KEY='replace-me'
ROUTES_JSON='{"routes":[{"id":"R1","origin":"private origin","destination":"private destination"}]}'
TRAFFIC_TIMEZONE='America/Los_Angeles'
MAX_MONTHLY_GOOGLE_REQUESTS='4500'
SLOT_TOLERANCE_MINUTES='7'
